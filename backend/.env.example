# Goodly Backend Environment Configuration
# Copy values into backend/.env (already git-ignored in .gitignore)

APP_ENV=development
HTTP_ADDR=:8080
WS_ADDR=:8081

# Local Docker Compose defaults (postgres-postgis, redis, rabbitmq)
DATABASE_URL=postgres://goodly:goodly_secret@localhost:5432/goodly_db?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
RABBITMQ_URL=amqp://goodly:goodly_secret@localhost:5672/
OPENSEARCH_URL=http://localhost:9200

# Auth & Quote Signing Secrets (replace with 32+ char random secrets in staging/prod)
JWT_ACCESS_SECRET=goodly-dev-jwt-secret-change-in-production-32bytes
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Payment Gateway Configuration (Razorpay Test/Live Keys)
# Leave blank in local dev to use the built-in HMAC-compatible sandbox provider
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional Email (Brevo SMTP/API v3 for Auth OTPs and Onboarding/KYC alerts)
BREVO_KEY=
BREVO_SENDER_EMAIL=noreply@goodly.in
BREVO_SENDER_NAME=Goodly Food Delivery
